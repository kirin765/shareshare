# ShareShare signaling server environment.
# Copy to /etc/shareshare/signaling.env (mode 0600) and adjust.

PORT=8787
HOST=127.0.0.1

# Comma-separated exact browser origins. "*" disables origin validation and is
# not recommended for production.
ALLOWED_ORIGINS=https://shareshare.example.com
ALLOW_MISSING_ORIGIN=false
TRUST_PROXY=true

ROOM_TTL_MS=900000
RECONNECT_GRACE_MS=120000
HEARTBEAT_TIMEOUT_MS=60000
SWEEP_INTERVAL_MS=30000

MAX_MESSAGE_BYTES=65536
MAX_ROOMS=1000
MAX_MESSAGES_PER_MINUTE=600
MAX_ATTACH_ATTEMPTS_PER_MINUTE=30

STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SECRET=replace-with-at-least-16-characters
TURN_TTL_SECONDS=600
TURN_REALM=shareshare
